{
  "manifest_version": 3,
  "name": "YSummarize",
  "description": "An extension to provide summarized transcript of a YouTube Subtitle eligible Video.",
  "version": "1.0",

  "permissions": ["activeTab", "tabs", "scripting"],
  "host_permissions": ["https://www.youtube.com/*", "http://localhost:5000/*"],

  "action": {
    "default_title": "YSummarize",
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/watch*", "*://youtu.be/*", "*://www.youtube.com/shorts/*"],
      "js": ["contentScript.js"]
    }
  ]
}
